<Window x:Class="MajdataEdit.CoverVideoExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture="zh-CN"
        lex:ResxLocalizationProvider.DefaultAssembly="MajdataEdit"
        lex:ResxLocalizationProvider.DefaultDictionary="Langs"
        Title="{lex:Loc CoverVideoExportTitle}"
        Height="410"
        Width="540"
        MinHeight="410"
        MinWidth="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="InputPanel">
            <TextBlock Text="{lex:Loc CoverVideoSourceImage}"
                       Foreground="{DynamicResource ButtonForeground}"
                       FontWeight="Bold" />
            <TextBox x:Name="SourceImageTextBox"
                     Margin="0,6,0,14"
                     Height="28"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource ButtonsBackground}"
                     Foreground="{DynamicResource ButtonForeground}" />

            <TextBlock Text="{lex:Loc CoverVideoOutputDirectory}"
                       Foreground="{DynamicResource ButtonForeground}"
                       FontWeight="Bold" />
            <Grid Margin="0,6,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputDirectoryTextBox"
                         Height="28"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource ButtonsBackground}"
                         Foreground="{DynamicResource ButtonForeground}" />
                <Button Grid.Column="1"
                        Content="{lex:Loc CoverVideoSelectOutputDirectory}"
                        Width="104"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="SelectOutputDirectory_Click"
                        Background="{DynamicResource ButtonsBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Template="{DynamicResource DarkButton}" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{lex:Loc CoverVideoBaseMusicId}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ButtonForeground}"
                           FontWeight="Bold" />
                <TextBox x:Name="BaseMusicIdTextBox"
                         Grid.Column="1"
                         Height="28"
                         MaxLength="4"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="15"
                         PreviewTextInput="BaseMusicIdTextBox_PreviewTextInput"
                         TextChanged="MusicIdOption_Changed"
                         Background="{DynamicResource ButtonsBackground}"
                         Foreground="{DynamicResource ButtonForeground}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="132,0,0,14">
                <CheckBox x:Name="IsUtageCheckBox"
                          Content="{lex:Loc CoverVideoIsUtage}"
                          Width="120"
                          Checked="MusicIdOption_Changed"
                          Unchecked="MusicIdOption_Changed"
                          Foreground="{DynamicResource ButtonForeground}"
                          Background="{DynamicResource ButtonsBackground}"
                          Template="{DynamicResource DarkCheck}" />
                <CheckBox x:Name="IsDxCheckBox"
                          Content="{lex:Loc CoverVideoIsDx}"
                          Checked="MusicIdOption_Changed"
                          Unchecked="MusicIdOption_Changed"
                          Foreground="{DynamicResource ButtonForeground}"
                          Background="{DynamicResource ButtonsBackground}"
                          Template="{DynamicResource DarkCheck}" />
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{lex:Loc CoverVideoFinalMusicId}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ButtonForeground}"
                           FontWeight="Bold" />
                <TextBox x:Name="FinalMusicIdTextBox"
                         Grid.Column="1"
                         Height="28"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="15"
                         Background="{DynamicResource ButtonsBackground}"
                         Foreground="{DynamicResource ButtonForeground}" />
            </Grid>

            <TextBlock Text="{lex:Loc CoverVideoOneSecondHint}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ButtonForeground}"
                       Opacity="0.8" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ButtonForeground}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ConfirmButton"
                        Content="{lex:Loc CoverVideoConfirm}"
                        Width="84"
                        Height="28"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="ConfirmButton_Click"
                        Background="{DynamicResource ButtonsBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Template="{DynamicResource DarkButton}" />
                <Button x:Name="CancelButton"
                        Content="{lex:Loc CoverVideoCancel}"
                        Width="84"
                        Height="28"
                        IsCancel="True"
                        Background="{DynamicResource ButtonsBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Template="{DynamicResource DarkButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
