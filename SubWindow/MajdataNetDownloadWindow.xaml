<Window x:Class="MajdataEdit.MajdataNetDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture="zh-CN"
        lex:ResxLocalizationProvider.DefaultAssembly="MajdataEdit"
        lex:ResxLocalizationProvider.DefaultDictionary="Langs"
        Title="{lex:Loc MajdataNetDownloadTitle}"
        Height="330"
        Width="700"
        MinHeight="330"
        MinWidth="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="InputPanel">
            <TextBlock Text="{lex:Loc MajdataNetSaveDirectory}"
                       Foreground="{DynamicResource ButtonForeground}"
                       FontWeight="Bold" />
            <Grid Margin="0,6,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveDirectoryTextBox"
                         Height="30"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource ButtonsBackground}"
                         Foreground="{DynamicResource ButtonForeground}" />
                <Button x:Name="SelectDirectoryButton"
                        Grid.Column="1"
                        Content="{lex:Loc MajdataNetSelectDirectory}"
                        Width="112"
                        Height="30"
                        Margin="8,0,0,0"
                        Click="SelectDirectory_Click"
                        Background="{DynamicResource ButtonsBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Template="{DynamicResource DarkButton}" />
            </Grid>

            <CheckBox x:Name="UseTemporaryDirectoryCheckBox"
                      Content="{lex:Loc MajdataNetUseTemporaryDirectory}"
                      Margin="0,0,0,16"
                      Checked="UseTemporaryDirectory_Changed"
                      Unchecked="UseTemporaryDirectory_Changed"
                      Background="{DynamicResource ButtonsBackground}"
                      Foreground="{DynamicResource ButtonForeground}"
                      Template="{DynamicResource DarkCheck}" />

            <TextBlock Text="{lex:Loc MajdataNetSongUrl}"
                       Foreground="{DynamicResource ButtonForeground}"
                       FontWeight="Bold" />
            <TextBox x:Name="SongUrlTextBox"
                     Height="30"
                     Margin="0,6,0,8"
                     VerticalContentAlignment="Center"
                     FontFamily="Consolas"
                     Background="{DynamicResource ButtonsBackground}"
                     Foreground="{DynamicResource ButtonForeground}" />
            <TextBlock Text="https://majdata.net/song?id=0a3a9c77-92e0-4a16-98cc-f6ebeee31df5"
                       Foreground="{DynamicResource ButtonForeground}"
                       Opacity="0.65" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock"
                           Foreground="{DynamicResource ButtonForeground}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="3"
                             Margin="0,5,18,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DownloadButton"
                        Content="{lex:Loc MajdataNetDownloadButton}"
                        Width="90"
                        Height="30"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="DownloadButton_Click"
                        Background="{DynamicResource ButtonsBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Template="{DynamicResource DarkButton}" />
                <Button x:Name="CancelButton"
                        Content="{lex:Loc Cancel}"
                        Width="90"
                        Height="30"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Background="{DynamicResource ButtonsBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Template="{DynamicResource DarkButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
