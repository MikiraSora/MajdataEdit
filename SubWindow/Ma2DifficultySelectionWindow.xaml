<Window x:Class="MajdataEdit.Ma2DifficultySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导出难度"
        Height="330"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="选择要生成 MA2 的难度"
                   Foreground="{DynamicResource ButtonForeground}"
                   FontWeight="Bold"
                   Margin="0,0,0,10" />

        <ListBox x:Name="DifficultyList"
                 Grid.Row="1"
                 ItemsSource="{Binding Options}"
                 Background="{DynamicResource ButtonsBackground}"
                 Foreground="{DynamicResource ButtonForeground}"
                 BorderBrush="#FF555555">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="DifficultyCheckBox_Changed"
                              Unchecked="DifficultyCheckBox_Changed"
                              Foreground="{DynamicResource ButtonForeground}"
                              Background="{DynamicResource ButtonsBackground}"
                              Template="{DynamicResource DarkCheck}"
                              Margin="2,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="48" Text="{Binding DiffId, StringFormat=# {0}}" />
                            <TextBlock Width="112" Text="{Binding DifficultyName}" />
                            <TextBlock Text="{Binding Level, StringFormat=Lv. {0}}" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="OkButton"
                    Content="确定"
                    Width="84"
                    Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OkButton_Click"
                    Background="{DynamicResource ButtonsBackground}"
                    Foreground="{DynamicResource ButtonForeground}"
                    Template="{DynamicResource DarkButton}" />
            <Button Content="取消"
                    Width="84"
                    Height="28"
                    IsCancel="True"
                    Background="{DynamicResource ButtonsBackground}"
                    Foreground="{DynamicResource ButtonForeground}"
                    Template="{DynamicResource DarkButton}" />
        </StackPanel>
    </Grid>
</Window>
